---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import Overview from '../components/Overview.astro';
import Rooms from '../components/Rooms.astro';
import Amenities from '../components/Amenities.astro';
import Welcome from '../components/Welcome.astro';
import Guide from '../components/Guide.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Host from '../components/Host.astro';
import Footer from '../components/Footer.astro';
import StickyBookBar from '../components/StickyBookBar.astro';
---
<Layout>
  <Header />
  <main>
    <Hero />
    <div class="bg-[#F8F6F0]"><Welcome /></div>
    <div class="bg-white"><Gallery /></div>
    <div class="bg-[#FAF9F5]"><Overview /></div>
    <div class="bg-[#FAF9F5]"><Rooms /></div>
    <div class="bg-white"><Amenities /></div>
    <div class="bg-[#F8F6F0]"><Reviews /></div>
    <Guide />
    <div class="bg-white"><Faq /></div>
    <div class="bg-[#FAF9F5]"><Host /></div>
  </main>
  <Footer />
  <StickyBookBar />
</Layout>
