---
import { property } from '../data/property';
import Icon from './Icon.astro';
const { space, rooms } = property;
const icons = ['Bath', 'TreePalm', 'Binoculars'];
---
<section id="rooms" class="bg-linen-100 py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="eyebrow">{space.eyebrow}</p>
    <h2 class="mt-4 max-w-3xl text-4xl sm:text-5xl">{space.heading}</h2>
    <p class="mt-6 max-w-2xl text-lg text-stone-warm">{space.intro}</p>
    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      {rooms.map((r) => {
        const [main, ...rest] = r.images;
        return (
          <article class="overflow-hidden rounded-2xl bg-linen-50 shadow-sm">
            <img src={main.src} alt={main.alt} loading="lazy" class="aspect-[3/2] w-full object-cover" />
            {rest.length > 0 && (
              <div class="grid gap-1 pt-1" style={`grid-template-columns: repeat(${rest.length}, minmax(0, 1fr))`}>
                {rest.map((img) => (
                  <img src={img.src} alt={img.alt} loading="lazy" class="aspect-[3/2] w-full object-cover" />
                ))}
              </div>
            )}
            <div class="p-6 sm:p-8">
              <h3 class="text-3xl">{r.name}</h3>
              <ul class="mt-4 space-y-2 text-stone-warm">
                {r.features.map((f, i) => (
                  <li class="flex gap-2"><Icon name={icons[i] ?? 'Sparkles'} size={18} class="mt-0.5 shrink-0 text-palm-500" />{f}</li>
                ))}
              </ul>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
