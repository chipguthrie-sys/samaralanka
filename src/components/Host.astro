---
import { property, whatsappUrl } from '../data/property';
import { MessageCircle } from 'lucide-astro';
---
<section id="host" class="mx-auto max-w-4xl px-5 py-24 lg:px-8">
  <div class="rounded-3xl bg-linen-100 p-10 text-center sm:p-14">
    <p class="eyebrow">Your Host</p>
    <h2 class="mt-4 text-4xl sm:text-5xl">Questions before you book?</h2>
    <p class="mx-auto mt-5 max-w-xl font-light leading-relaxed text-stone-warm">Message us directly for transfers, dietary needs, special occasions or help planning your stay. We usually reply within a few hours.</p>
    <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-8 py-4 text-sm font-medium text-white transition hover:brightness-95">
      <MessageCircle size={20} /> Message on WhatsApp
    </a>
    <p class="mt-4 text-xs text-stone-warm">Ready to reserve? <a class="underline" href={property.bookingUrl} target="_blank" rel="noopener noreferrer">Book on Booking.com</a></p>
  </div>
</section>
