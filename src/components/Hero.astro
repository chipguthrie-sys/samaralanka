---
import { property } from '../data/property';
import Icon from './Icon.astro';
const s = property.stats;
const badges = [
  { icon: 'Users', label: 'Guests', value: s.guests },
  { icon: 'BedDouble', label: 'Bedrooms', value: s.bedrooms },
  { icon: 'Bath', label: 'Bathrooms', value: s.bathrooms },
  { icon: 'Star', label: `Rating (${s.reviews})`, value: s.rating },
];
---
<section id="top" class="relative flex min-h-screen items-end text-white">
  <img src={property.images.hero} alt={`${property.name} villa`} class="absolute inset-0 h-full w-full object-cover" loading="eager" decoding="async" fetchpriority="high" />
  <div class="absolute inset-0 z-10 bg-gradient-to-t from-black/80 via-black/35 to-black/20"></div>
  <div class="relative z-20 mx-auto w-full max-w-7xl px-5 pb-28 pt-40 lg:px-8 md:pb-24">
    <p class="eyebrow !text-white/80">{property.location.area}, {property.location.country}</p>
    <h1 class="mt-4 max-w-3xl text-5xl leading-[1.05] sm:text-6xl lg:text-7xl">{property.tagline}</h1>
    <p class="mt-6 max-w-xl text-base font-light leading-relaxed text-white/85 sm:text-lg">{property.subtitle}</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      {badges.map((b) => (
        <li class="flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm backdrop-blur">
          <Icon name={b.icon} size={16} /><span class="font-medium">{b.value}</span><span class="text-white/80">{b.label}</span>
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href={property.bookingUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-white px-8 py-4 text-sm font-medium text-ink transition hover:bg-linen-100">Book on Booking.com</a>
      <a href="#overview" class="text-sm underline underline-offset-8 opacity-90 hover:opacity-100">Explore the villa</a>
    </div>
  </div>
</section>
