---
import { property } from '../data/property';
const { welcome } = property;
const p = welcome.photo;
---
<section id="welcome" class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <figure class="group mx-auto w-full max-w-md lg:max-w-none">
      <div class="overflow-hidden rounded-2xl border border-stone-200 shadow-sm">
        <img src={p.src} alt={p.alt} loading="lazy" class={`aspect-[4/5] w-full object-cover ${p.position} transition-transform duration-500 ease-out group-hover:scale-[1.02]`} />
      </div>
      <figcaption class="mt-4 text-center font-serif text-lg italic text-stone-warm">{p.caption}</figcaption>
    </figure>

    <div>
      <p class="eyebrow">{welcome.eyebrow}</p>
      <h2 class="mt-4 text-4xl leading-tight sm:text-5xl">{welcome.heading}</h2>
      <div class="mt-8 space-y-5 text-lg font-light leading-relaxed text-stone-warm">
        {welcome.body.map((t) => <p>{t}</p>)}
      </div>
    </div>
  </div>
</section>
